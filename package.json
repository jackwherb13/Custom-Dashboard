{
  "name": "dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "concurrently -k \"node --watch --env-file-if-exists=.env server/index.js\" \"vite\"",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.2.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supertest": "^7.3.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
